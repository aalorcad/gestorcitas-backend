                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Responde JSON', () => pm.response.to.be.json);",
                  "const h = pm.response.json().horariosDisponibles || [];",
                  "pm.test('Hay horarios', () => pm.expect(h.length).to.be.above(2));",
                  "pm.collectionVariables.set('horaA', h[0]);",
                  "pm.collectionVariables.set('horaB', h[1]);",
                  "pm.collectionVariables.set('horaC', h[2]);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Próximo día hábil (lunes a viernes)",
                  "if (!pm.collectionVariables.get('fecha')) {",
                  "  const d = new Date(); d.setDate(d.getDate() + 1);",
                  "  while ([0, 6].includes(d.getDay())) d.setDate(d.getDate() + 1);",
                  "  pm.collectionVariables.set('fecha', d.toISOString().slice(0, 10));",
                  "}"
                ]
              }
            }
          ]
