# =====================================================================
# Copiar a .env y completar. Guía: docs/00-guia-paso-a-paso.md
# =====================================================================

# --- Oracle Autonomous Database (docs/03-oracle-autonomous-db.md)
# Cadena de conexión TLS copiada desde OCI > Database connection > TLS (servicio _low),
# precedida de "jdbc:oracle:thin:@". Déjala entre comillas simples.
DB_URL='jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.sa-santiago-1.oraclecloud.com))(connect_data=(service_name=xxxxxxxx_gestorcitas_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))'
# Oracle local (docker compose --profile oracle-local):
# DB_URL=jdbc:oracle:thin:@//oracle-local:1521/FREEPDB1

# Un esquema por microservicio (mismas contraseñas que en infra/db/oracle/adb/01-crear-esquemas.sql)
CATALOGO_DB_USER=CATALOGO
CATALOGO_DB_PASSWORD=<CLAVE_CATALOGO>
USUARIOS_DB_USER=USUARIOS
USUARIOS_DB_PASSWORD=<CLAVE_USUARIOS>
CITAS_DB_USER=CITAS
CITAS_DB_PASSWORD=<CLAVE_CITAS>

# Conexiones por microservicio (Always Free admite pocas sesiones simultáneas)
DB_POOL_SIZE=4

# --- Microsoft Entra ID (App Registration de la API) — docs/01-entra-id.md
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_APP_ID_URI=api://00000000-0000-0000-0000-000000000000
ENTRA_REQUIRED_SCOPE=access_as_user

# --- Microsoft Entra ID (App Registration del FRONTEND, tipo SPA) — se usa al construir la imagen del frontend
FRONT_CLIENT_ID=00000000-0000-0000-0000-000000000000
API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# --- Email (UPN) del médico de prueba en Entra ID (ms-usuarios lo pre-registra)
DEMO_MEDICO_EMAIL=medico1@<tu-tenant>.onmicrosoft.com

# --- Orígenes permitidos por el BFF (separar con coma). En AWS agrega la URL de API Gateway.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# --- Memoria máxima por microservicio Java (384m para EC2 de 4 GB, 256m para 2 GB)
JAVA_XMX=384m

# --- Solo EC2-A (BFF): IP PRIVADA de EC2-B donde corren los microservicios
MS_HOST=<IP_PRIVADA_EC2_MS>
